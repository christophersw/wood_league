DATABASE_URL=
RUNPOD_API_KEY=

# Endpoint IDs
RUNPOD_STOCKFISH_ENDPOINT_ID=
RUNPOD_LC0_ENDPOINT_ID=

# Optional legacy fallback for stockfish only
RUNPOD_ENDPOINT_ID=

# Dispatch tuning
SF_POLL_INTERVAL=60
LC0_POLL_INTERVAL=60

# Periodic Chess.com ingest
CHESS_COM_USERNAMES=
INGEST_POLL_INTERVAL=900
INGEST_MONTH_LIMIT=24
CHESS_COM_USER_AGENT=wood-league-dispatchers/0.1 (+runpod dispatcher)

# Immediately queue newly ingested games
QUEUE_STOCKFISH_AFTER_INGEST=true
QUEUE_LC0_AFTER_INGEST=false

# Stockfish payload defaults
ANALYSIS_DEPTH=20
ANALYSIS_THREADS=8
ANALYSIS_HASH_MB=2048

# Lc0 payload defaults
LC0_NODES=25000
LC0_NETWORK=
