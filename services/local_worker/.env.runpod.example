# Sample env-var configuration for running ``wood-league-worker`` on a
# RunPod GPU pod. Copy these into the "Environment Variables" section of
# the RunPod template / pod creation form. Variables marked REQUIRED must
# be set; OPTIONAL ones have sensible defaults baked into the Dockerfile /
# bootstrap script.

# === REQUIRED =============================================================

# Wood League API base URL. ``https://`` is added automatically if omitted.
WLW_API_URL=https://wood-league.example.com

# Worker API token. Issued by an admin from the Django app.
WLW_API_KEY=replace-me-with-real-token

# === OPTIONAL: identity ===================================================

# Stable identifier for this worker. Defaults to a generated UUID stored on
# the data volume on first boot.
# WLW_WORKER_ID=runpod-a100-1

# === OPTIONAL: storage ====================================================

# Where the worker keeps eval-cache and tuner state. Defaults to the
# /workspace/data volume so it survives pod recreation.
# WLW_DATA_DIR=/workspace/data

# Path to the lc0 weights file on the volume. The bootstrap script
# downloads BT4 here on first boot if missing.
# WLW_LC0_WEIGHTS_PATH=/workspace/weights/BT4-1024x15x32h-swa-6147500.pb.gz

# Directory containing Syzygy 3-4-5 .rtbw/.rtbz files.
# WLW_SYZYGY_PATH=/workspace/syzygy

# === OPTIONAL: engine binaries ============================================

# WLW_LC0_PATH=/usr/local/bin/lc0
# WLW_STOCKFISH_PATH=/usr/games/stockfish

# lc0 backend. ``cuda-fp16`` is the right choice for A100/H100/RTX 30xx+.
# WLW_LC0_BACKEND=cuda-fp16

# === OPTIONAL: engine tuning ==============================================

# Comma-separated engines for the ``run`` command. ``stockfish,lc0`` runs
# both; ``stockfish`` alone runs CPU-only.
# WLW_DEFAULT_ENGINES=stockfish,lc0

# Leave 1-2 vCPUs free for lc0 host-side work on small pods.
# WLW_STOCKFISH_THREADS=7

# WLW_STOCKFISH_DEPTH=20
# WLW_STOCKFISH_HASH_MB=512
# WLW_LC0_NODES=10000

# === OPTIONAL: batching ===================================================

# Default batch size when invoking ``wood-league-worker run``.
# WLW_DEFAULT_BATCH_SIZE=10

# When set, the ``run`` loop exits after this many minutes (useful for
# scheduled / spot pods). Leave unset for "drain the queue and exit".
# WLW_BATCH_TIME_MINUTES=

# === OPTIONAL: eval cache =================================================

# WLW_EVAL_CACHE_ENABLED=true
# WLW_EVAL_CACHE_MAX_MB=500
