{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(bandit *)",
      "Bash(/opt/homebrew/bin/ruff *)",
      "Bash(/opt/homebrew/bin/snyk code test *)",
      "mcp__vexp__run_pipeline",
      "mcp__vexp__get_skeleton",
      "Bash(git-issues list *)",
      "Bash(git-issues show *)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(.claude/settings.local.json)",
      "Read(node_modules/**)",
      "Read(__pycache__/**)",
      "Read(**/*.pyc)",
      "Read(staticfiles/**)",
      "Read(media/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Regex",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/vexp-guard.sh",
            "timeout": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); [[ \"$f\" == *.py ]] || exit 0; errors=\"\"; /opt/homebrew/bin/ruff check \"$f\" || errors=\"ruff:FAIL $errors\"; /Users/christopherwebster/.local/bin/bandit -ll -q \"$f\" 2>/dev/null || errors=\"bandit:FAIL $errors\"; /opt/homebrew/bin/snyk code test \"$f\" 2>/dev/null || errors=\"snyk:FAIL $errors\"; [[ -z \"$errors\" ]] && exit 0 || { echo \"Security/lint issues found: $errors\"; exit 2; }",
            "asyncRewake": true,
            "timeout": 60,
            "statusMessage": "Running ruff, bandit, Snyk..."
          }
        ]
      }
    ]
  }
}
